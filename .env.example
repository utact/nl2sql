# Copy to .env:  cp .env.example .env
#
# Only what the code cannot know: secrets, and paths that exist on this machine.
# Anything with a default in code stays out: two sources drift, and drift is silent.
# Real environment variables always win; this file only fills what is unset.

# Local model
# The code default is a hub ID, which offline mode will not download.
# Point at weights you already have.
#NL2SQL_HF_MODEL=/path/to/Qwen2.5-1.5B-Instruct

# Hosted API backend
# Offline mode is on by default and blocks API backends outright, so both lines are needed.
# Uncomment only where the data may leave the network.
#NL2SQL_OFFLINE=0
#NL2SQL_LLM=nvidia
#NVIDIA_API_KEY=nvapi-...

# PostgreSQL backend
# Default is SQLite. Start deploy/compose.yaml first.
#NL2SQL_DB_BACKEND=postgres
#NL2SQL_PG_DSN=postgresql://nl2sql_app:demo-only-not-a-secret@127.0.0.1:5432/inspection
# If a local PostgreSQL already holds 5432, publish on another port and match the DSN above.
#NL2SQL_PG_PORT=5433
